{
    "compilerOptions": {
        "baseUrl": "./src",
        "paths": {
            "@assets/*": ["assets/*"],
            "@constant": ["constant/index"],
            "@theme": ["theme/index"],
            "@components": ["components/index"],
            "@components/*": ["components/*"],
            "@store": ["store/index"],
            "@store/*": ["store/*"],
            "@pages": ["pages/index"],
            "@pages/*": ["pages/*"],
            "@routes": ["routes/index"],
            "@routes/*": ["routes/*"],
            "@app": ["App.component"],
            "@providers": ["providers/index"]
        }
    }
}
